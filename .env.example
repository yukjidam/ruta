# ============================================================
# RUTA — environment template
# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored — `.env.example` is the tracked reference.
# Nothing in this app reads these yet (UI-only build) — this is
# here so the wiring is a drop-in when the backend work starts.
# ============================================================

# ---- Supabase (auth, database, realtime) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- Cloudflare R2 (photo storage) ----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ruta-ride-photos
# Public bucket URL or custom domain photos will be served from
R2_PUBLIC_URL=https://photos.your-domain.com

# ---- OpenRouteService (routing / turn-by-turn) ----
ORS_API_KEY=your-openrouteservice-api-key

# ---- Map tiles (OpenStreetMap — no key required by default) ----
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ---- Notes ----
# Firebase Cloud Messaging (push notifications) is NOT configured here —
# it uses google-services.json (Android) / GoogleService-Info.plist (iOS),
# which are files you download from the Firebase console and drop into
# android/app/ and ios/Runner/ respectively. Both are already gitignored.
